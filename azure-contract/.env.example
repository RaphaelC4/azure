# Azure dispute harness env — loaded via node --env-file=.env
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env (it holds private keys).

# studio-dev (61997) contract — written by `npm run deploy` (deploy_devnet.mjs)
AZURE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Legacy studionet (61999) overrides — the 61999 tools default to the canonical
# fresh hackathon instance baked into each script; set these to retarget:
# SMOKE_CONTRACT       target contract for probe_smoke_sn.mjs
# STUDIONET_CONTRACT   target contract for read_az2.mjs
# READ_CASE_ID         case id for read_az2.mjs (default AZ-1)
# CASE_ID              case id for probe_accept_sn.mjs

# Studionet accounts funded with GEN (see the studionet faucet).
# Agent A files disputes and deploys; Agent B is the respondent.
# Keys stay local — .env is gitignored.
AGENT_A_PRIVATE_KEY=0xyour_agent_a_private_key
AGENT_B_PRIVATE_KEY=0xyour_agent_b_private_key
