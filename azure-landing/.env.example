# WalletConnect — optional QR-modal wallet for Azure.
# Get a free Project ID at https://cloud.walletconnect.com and drop it in.
# Without it, the app falls back to an injected wallet (Rabby / MetaMask).
# NOTE: NEXT_PUBLIC_* vars are baked at BUILD time — on Vercel, set the env
# var (type: Config, scope: Production) BEFORE deploying/redeploying.
NEXT_PUBLIC_WC_PROJECT_ID=

# Default GenLayer net for the studio-dev <-> studionet switcher.
# 61997 = studio-dev net (default), 61999 = legacy studionet.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997

# Per-net deployed Azure contract instances (baked at build time).
# - studio-dev (61997): full lifecycle, real GEN stakes, native emit_transfer
#   payouts (settle/reclaim pay GEN directly) - the default net.
# - studionet (61999): LIVE (re-deployed 2026-09-13). genlayer-js 2.0.0-rc.1's
#   default envelopes are unusable there — deploys/writes need the
#   V5 flat addTransaction (lib/genlayer-v5.ts) and reads need the legacy
#   "method"-key calldata (readCallV5); the SDK's own readContract/writeContract
#   land as empty txs / fail net-wide on 61999. See writesAvailable in
#   app/lib/contract.ts.
NEXT_PUBLIC_CONTRACT_STUDIO_DEV=0x22473F53712A5cf944D8f7eDCc38681C28C1Ce16
NEXT_PUBLIC_CONTRACT_STUDIONET=0x1d0CAF3f9CC120d2701A16Ff7a43409B49c2868e
# NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS still works as the default net's
# address when NEXT_PUBLIC_CONTRACT_STUDIO_DEV is unset.